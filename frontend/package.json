{
  "name": "rutaexpress-frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start:admin": "ng serve admin",
    "start:driver": "ng serve driver",
    "build": "ng build admin && ng build driver --base-href /app/",
    "test": "ng test shared --watch=false",
    "generate:api": "openapi-typescript http://localhost:8080/v3/api-docs -o projects/shared/src/lib/api/schema.d.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/service-worker": "^21.0.0",
    "@stomp/stompjs": "^7.5.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "1.9",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
