# Copia este fichero a .env y cambia TODOS los secretos. .env no se sube al repositorio.

# --- Base de datos ---
POSTGRES_DB=rutaexpress
POSTGRES_USER=rutaexpress
POSTGRES_PASSWORD=cambia-esta-contraseña

# --- Seguridad (mínimo 32 caracteres; genera uno con: openssl rand -base64 48) ---
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-48-bytes

# --- Ficheros (MinIO) ---
MINIO_ROOT_USER=rutaexpress
MINIO_ROOT_PASSWORD=cambia-esta-contraseña-minio

# --- Monitorización ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esta-contraseña-grafana

# --- Geocodificación ---
# Con Nominatim propio (perfil "nominatim"): NOMINATIM_URL=http://nominatim:8080 y NOMINATIM_PUBLIC=false
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_PUBLIC=true
NOMINATIM_USER_AGENT=RutaExpress/0.1 (contacto@tu-dominio.es)

# --- Optimización: NEAREST_NEIGHBOR, TWO_OPT u OR_TOOLS ---
ROUTING_ALGORITHM=OR_TOOLS

# --- Asistente IA (opcional) ---
ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5

# --- Datos de demostración (un día de reparto en Valencia) ---
DEMO_DATA=true

# --- Producción (docker-compose.prod.yml) ---
DOMAIN=rutaexpress.example.com
LETSENCRYPT_EMAIL=admin@example.com
PUBLIC_ORIGIN=http://localhost
REGISTRY=ghcr.io/tu-usuario/rutaexpress
TAG=latest
