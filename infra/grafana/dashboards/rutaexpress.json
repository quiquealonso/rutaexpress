{
  "uid": "rutaexpress-main",
  "title": "RutaExpress",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "rutaexpress"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latencia HTTP p95 por endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{application=\"rutaexpress\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Peticiones por segundo y estado",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"rutaexpress\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tiempo de optimización por algoritmo (media)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (algorithm) (rate(rutaexpress_optimization_time_seconds_sum[15m])) / sum by (algorithm) (rate(rutaexpress_optimization_time_seconds_count[15m]))",
          "legendFormat": "{{algorithm}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Origen de la matriz de tiempos",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (increase(rutaexpress_matrix_requests_total[1h]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pool de conexiones HikariCP",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{application=\"rutaexpress\"}",
          "legendFormat": "activas"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{application=\"rutaexpress\"}",
          "legendFormat": "libres"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{application=\"rutaexpress\"}",
          "legendFormat": "esperando"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM: memoria heap usada",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"rutaexpress\", area=\"heap\"})",
          "legendFormat": "heap"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PostgreSQL: conexiones y transacciones/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "conexiones"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pg_stat_database_xact_commit[1m]))",
          "legendFormat": "commits/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tiempo de respuesta de OSRM (table)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(rutaexpress_osrm_table_seconds_sum[5m]) / rate(rutaexpress_osrm_table_seconds_count[5m])",
          "legendFormat": "media"
        }
      ]
    }
  ]
}